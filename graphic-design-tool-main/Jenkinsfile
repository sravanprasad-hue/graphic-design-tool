pipeline {
    agent any

    environment {
        BLUE_HOST = "13.238.248.58"
        GREEN_HOST = "13.54.192.16"
        PROJECT_DIR = "/home/ubuntu/graphic-design-tool/graphic-design-tool-main"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Workspace') {
            steps {
                sh '''
                pwd
                ls -la
                '''
            }
        }

        stage('Test SSH Connection') {
            steps {
                sshagent(credentials: ['blue-green-key']) {

                    sh '''
                    echo "===== BLUE SERVER ====="
                    ssh -o StrictHostKeyChecking=no ubuntu@$BLUE_HOST "
                        hostname
                        pwd
                        ls -ld $PROJECT_DIR
                    "

                    echo "===== GREEN SERVER ====="
                    ssh -o StrictHostKeyChecking=no ubuntu@$GREEN_HOST "
                        hostname
                        pwd
                        ls -ld $PROJECT_DIR
                    "
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SSH connectivity verified successfully.'
        }

        failure {
            echo 'SSH verification failed.'
        }
    }
}
