pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '428708298136'

        BACKEND_IMAGE = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/graphic-design-backend:latest"
        FRONTEND_IMAGE = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/graphic-design-frontend:latest"

        CLUSTER_NAME = 'graphic-design-eks'
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    docker --version
                    aws --version
                    kubectl version --client
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                dir('graphic-design-tool-main/Backend') {
                    sh '''
                        docker build -t ${BACKEND_IMAGE} .
                    '''
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                dir('graphic-design-tool-main/Frontend') {
                    sh '''
                        docker build -t ${FRONTEND_IMAGE} .
                    '''
                }
            }
        }

        stage('Push Images to Amazon ECR') {
            steps {
                sh '''
                    docker push ${BACKEND_IMAGE}
                    docker push ${FRONTEND_IMAGE}
                '''
            }
        }

        stage('Update kubeconfig') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                    --name ${CLUSTER_NAME} \
                    --region ${AWS_REGION}
                '''
            }
        }

        stage('Verify Kubernetes Files') {
            steps {
                dir('graphic-design-tool-main/k8s') {
                    sh '''
                        pwd
                        ls -l
                    '''
                }
            }
        }

        stage('Deploy to Amazon EKS') {
            steps {
                dir('graphic-design-tool-main/k8s') {
                    sh '''
                        kubectl apply -f backend-deployment.yaml
                        kubectl apply -f backend-service.yaml
                        kubectl apply -f frontend-deployment.yaml
                        kubectl apply -f frontend-service.yaml

                        kubectl rollout restart deployment graphic-design-backend
                        kubectl rollout restart deployment graphic-design-frontend

                        kubectl rollout status deployment/graphic-design-backend
                        kubectl rollout status deployment/graphic-design-frontend
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "========== Deployments =========="
                    kubectl get deployments

                    echo ""
                    echo "========== Pods =========="
                    kubectl get pods -o wide

                    echo ""
                    echo "========== Services =========="
                    kubectl get svc
                '''
            }
        }
    }

    post {
        success {
            echo "=================================="
            echo "EKS Deployment Completed Successfully"
            echo "=================================="
        }

        failure {
            echo "=================================="
            echo "Pipeline Failed"
            echo "=================================="
        }

        always {
            cleanWs()
        }
    }
}
